# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Datasets (keep large data files out of Git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints and generated weights
models/*
*.pt
*.pth
*.onnx
*.safetensors

# Jupyter
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Application state (git-ignored per spec Part 9)
state/

# Feature caches (large, reproducible)
data/processed/feature_cache/
data/processed/dinov2_cache/

# Manifests contain no data but are large JSON; committed selectively
# data/manifests/  <- we WANT these committed (small JSON, no images)

# Artifacts base: small stats committed, weights never
# (*.pt / *.pth already excluded above)
artifacts/base/weights/

# pytest
.pytest_cache/
