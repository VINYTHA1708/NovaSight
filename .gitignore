# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Datasets (keep large data files out of Git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints and generated weights
models/*
*.pt
*.pth
*.onnx
*.safetensors

# Jupyter
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
