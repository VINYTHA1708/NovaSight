# NovaSight environment variables
# Copy to .env and fill in values (do NOT commit .env)

# Hugging Face token (optional; used only for uploading model weights and event log)
# Required permission: write access to your model repo and optionally a private dataset repo
HF_TOKEN=

# HF model repo (where backbone weights are stored for Spaces deployment)
HF_MODEL_REPO=

# HF dataset repo for event log sync (optional, private recommended)
HF_DATASET_REPO=

# Set to "demo" to enable per-session sandbox mode in the Gradio app
NOVASIGHT_MODE=
